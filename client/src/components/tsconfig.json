{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["../../src/*"],
      "@shared/*": ["../../../shared/*"]
    }
  },
  "include": ["./**/*.tsx", "./**/*.ts", "../lib/**/*.ts"]
}
